# Agent wallet (generate with: npx tsx scripts/new-wallet.ts). Never commit .env.
AGENT_PRIVATE_KEY=
# Deployer key for the contract (can be the same as the agent key for the first deploy).
DEPLOYER_PRIVATE_KEY=
# Address that will own the escrow contract (your own wallet; admin only, cannot move user funds).
OWNER_ADDRESS=
# Fees collected on release go here.
TREASURY_ADDRESS=
ESCROW_ADDRESS=
CELO_RPC_URL=https://forno.celo.org
# Attribution tag(s) issued at hackathon enrolment, comma separated.
ATTRIBUTION_CODES=celo_0546234e302b
# Optional: Textile partner key. Without it the agent signs a proof of control per wallet.
TEXTILE_API_KEY=
# Optional: used by the agent to review delivery evidence and draft dispute rulings.
ANTHROPIC_API_KEY=
